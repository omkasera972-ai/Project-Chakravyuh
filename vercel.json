{
    "services": {
        "frontend": {
            "root": "Project-Chakravyuh-Prototype",
            "framework": "vite"
        },
        "backend": {
            "root": "Project-Chakravyuh-Prototype/backend"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}